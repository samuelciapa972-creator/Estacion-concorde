# Plantilla de variables de entorno. Copie a `.env` (ignorado por git) y complete SOLO en su máquina.
#   set -a; source .env; set +a
# NUNCA suba el .env al repositorio ni lo comparta por chat o correo. Aquí no va ningún valor real.

# --- Base de datos -------------------------------------------------------------------------------
# Clave del PostgreSQL del docker-compose (si se omite, el compose usa 'estacion', solo para desarrollo local).
POSTGRES_PASSWORD=
# Cadena de conexión de la aplicación, p. ej. postgresql://estacion:<clave>@localhost:5432/estacion
DATABASE_URL=
# Base para las pruebas de integración (cada prueba usa un esquema temporal propio).
ESTACION_TEST_DSN=

# --- API (python -m estacion.api) ----------------------------------------------------------------
# Secreto para firmar los tokens de sesión: mínimo 32 caracteres aleatorios. Sin él la API no arranca.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# Minutos de validez del token (por defecto 60).
JWT_MINUTOS=60

# --- Captcha del registro público por QR ----------------------------------------------------------
# turnstile (Cloudflare) | hcaptcha | vacío = SIN captcha (solo banco de pruebas; la API lo advierte al arrancar).
# Con proveedor, faltar la clave del sitio o el secreto impide arrancar. La clave del sitio es pública; el secreto NO.
ESTACION_CAPTCHA_PROVEEDOR=
ESTACION_CAPTCHA_CLAVE_SITIO=
ESTACION_CAPTCHA_SECRETO=

# --- Stack en contenedores (make stack) ----------------------------------------------------------
# Nombres o IPs por los que se entra desde la tablet, separados por coma. Caddy emite el certificado para cada uno.
ESTACION_HOST=localhost
# Puertos publicados por Caddy. En la estación: 80 y 443 (con otros puertos, la redirección a HTTPS pierde el puerto).
ESTACION_PUERTO_HTTP=80
ESTACION_PUERTO_HTTPS=443

# --- DIAN. Solo habilitación: "2". Sin estas variables la API responde 503 al emitir (no se factura). ----
DIAN_AMBIENTE=2
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_CLAVE_TECNICA=
# (Fase 6, todavía no las lee el código) Rutas al certificado de firma y a su clave (fuera del repositorio). La clave del .p12 también es secreta.
DIAN_CERTIFICADO_RUTA=
DIAN_CERTIFICADO_CLAVE=
