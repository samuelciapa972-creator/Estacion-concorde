# Plantilla de variables de entorno. Copie a `.env` (ignorado por git) y complete SOLO en su máquina.
#   set -a; source .env; set +a
# NUNCA suba el .env al repositorio ni lo comparta por chat o correo. Aquí no va ningún valor real.

# --- Base de datos -------------------------------------------------------------------------------
# Clave del PostgreSQL del docker-compose (si se omite, el compose usa 'estacion', solo para desarrollo local).
POSTGRES_PASSWORD=
# Cadena de conexión de la aplicación, p. ej. postgresql://estacion:<clave>@localhost:5432/estacion
DATABASE_URL=
# Base para las pruebas de integración (cada prueba usa un esquema temporal propio).
ESTACION_TEST_DSN=

# --- API (python -m estacion.api) ----------------------------------------------------------------
# Secreto para firmar los tokens de sesión: mínimo 32 caracteres aleatorios. Sin él la API no arranca.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# Minutos de validez del token (por defecto 60).
JWT_MINUTOS=60

# --- Captcha del registro público por QR ----------------------------------------------------------
# turnstile (Cloudflare) | hcaptcha | vacío = SIN captcha (solo banco de pruebas; la API lo advierte al arrancar).
# Con proveedor, faltar la clave del sitio o el secreto impide arrancar. La clave del sitio es pública; el secreto NO.
ESTACION_CAPTCHA_PROVEEDOR=
ESTACION_CAPTCHA_CLAVE_SITIO=
ESTACION_CAPTCHA_SECRETO=

# --- Stack en contenedores (make stack) ----------------------------------------------------------
# Nombres o IPs por los que se entra desde la tablet, separados por coma. Caddy emite el certificado para cada uno.
ESTACION_HOST=localhost
# Puertos publicados por Caddy. En la estación: 80 y 443 (con otros puertos, la redirección a HTTPS pierde el puerto).
ESTACION_PUERTO_HTTP=80
ESTACION_PUERTO_HTTPS=443

# --- DIAN. "2" = habilitación (pruebas); "1" = PRODUCCIÓN (ver docs/salida-a-produccion.md). Sin estas variables la
# API responde 503 al emitir (no se factura). Con "1" no se admite DIAN_TEST_SET_ID, ni el certificado de prueba,
# ni el proveedor simulado, y la numeración activa debe ser la de producción. ----
DIAN_AMBIENTE=2
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_CLAVE_TECNICA=
# Set de pruebas de habilitación (portal DIAN). Con valor: `worker --proveedor dian` usa SendTestSetAsync.
# En producción (DIAN_AMBIENTE=1) debe quedar VACÍO.
DIAN_TEST_SET_ID=
# Certificado de firma (.pfx/.p12) y su clave, fuera del repositorio. La clave también es secreta.
# Para el banco de pruebas: `make certificado` genera uno de PRUEBA (sin validez) en datos/certificado-prueba.pfx.
# Sin certificado el worker NO envía nada: las facturas esperan en la cola.
DIAN_CERTIFICADO_RUTA=
DIAN_CERTIFICADO_CLAVE=

# --- Correo de entrega de facturas (worker) --------------------------------------------------------
# Sin definir host ni puerto: Mailpit (`make mail`), buzón de PRUEBA en http://localhost:8025, nada sale a internet
# (localhost:1025 con `make worker`; el contenedor mailpit con `make stack`).
# Correo REAL con Gmail (necesita verificación en 2 pasos y una "contraseña de aplicación", NO la de la cuenta):
#   ESTACION_SMTP_HOST=smtp.gmail.com
#   ESTACION_SMTP_PUERTO=587
#   ESTACION_SMTP_SEGURIDAD=starttls
#   ESTACION_SMTP_USUARIO=cuenta@gmail.com
#   ESTACION_SMTP_CLAVE=abcdefghijklmnop        (los 16 caracteres, sin espacios; es secreta)
#   ESTACION_CORREO_SOLO_A=cuenta@gmail.com     (mientras prueba)
# Pruébela antes con `make correo-prueba DESTINO=su@correo.com`.
# seguridad: ninguna (solo Mailpit) | starttls (puerto 587) | ssl (puerto 465). Con usuario, ninguna está prohibida.
ESTACION_SMTP_SEGURIDAD=ninguna
ESTACION_SMTP_USUARIO=
ESTACION_SMTP_CLAVE=
# From de los correos; vacío = el usuario. Las respuestas van al correo del emisor de la factura (Reply-To).
ESTACION_SMTP_REMITENTE=
# Lista blanca, separada por comas: si tiene direcciones, SOLO a ellas se envía (las demás quedan rechazadas con
# el motivo y se pueden reenviar). Úsela mientras prueba con un buzón real; vacía en producción.
ESTACION_CORREO_SOLO_A=
